# Telegram Bot API credential (server-only)
TELEGRAM_BOT_TOKEN=
# Secret configured in Telegram setWebhook; webhook requests without this header are rejected
FALANCE_TELEGRAM_WEBHOOK_SECRET=
# Public deployment URL, used by future server-generated links
NEXT_PUBLIC_APP_URL=
# Google service account identity and PKCS#8 private key (server-only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# ID of the central Falancé registry spreadsheet (server-only)
GOOGLE_FAMILY_REGISTRY_SPREADSHEET_ID=
# Invitation lifetime in hours; defaults to 24 when omitted
FALANCE_INVITATION_EXPIRY_HOURS=24
# IANA business timezone for relative dates and future-date validation; defaults to UTC
FALANCE_TIME_ZONE=UTC
# Optional OpenAI-compatible AI parser endpoint (server-only; include the /v1 path when required)
FALANCE_AI_API_BASE=
FALANCE_AI_API_KEY=
FALANCE_AI_MODEL=gpt-5-mini
# Optional vision-capable model for receipt parsing; leave empty until Milestone 7 vision provider is configured
FALANCE_AI_VISION_MODEL=
# Maximum downloaded receipt size in bytes; defaults to 10485760 (10 MiB)
FALANCE_RECEIPT_MAX_BYTES=10485760
# Receipt vision cooldown per active Telegram user/family; defaults to 30 seconds
FALANCE_RECEIPT_VISION_COOLDOWN_SECONDS=30
# Receipt vision rolling window; defaults to 3600 seconds (1 hour)
FALANCE_RECEIPT_VISION_WINDOW_SECONDS=3600
# Maximum receipt vision claims per active Telegram user/family/window; defaults to 5
FALANCE_RECEIPT_VISION_MAX_REQUESTS=5
# Lease for an in-flight receipt vision claim; defaults to 60 seconds
FALANCE_RECEIPT_VISION_LEASE_SECONDS=60
# Optional safe server-side timing logs; keep false unless diagnosing latency
FALANCE_TIMING_LOGS=false
