# Telegram Bot API credential (server-only)
TELEGRAM_BOT_TOKEN=
# Public deployment URL, used by future server-generated links
NEXT_PUBLIC_APP_URL=
# Google service account identity and PKCS#8 private key (server-only)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# ID of the central Falancé registry spreadsheet (server-only)
GOOGLE_FAMILY_REGISTRY_SPREADSHEET_ID=
# Invitation lifetime in hours; defaults to 24 when omitted
FALANCE_INVITATION_EXPIRY_HOURS=24
